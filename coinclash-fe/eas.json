{
  "cli": {
    "version": ">= 3.8.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://coinclash.saverr.tech"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://coinclash.saverr.tech"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
